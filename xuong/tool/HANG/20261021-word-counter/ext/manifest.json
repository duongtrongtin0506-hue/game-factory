{
 "manifest_version": 3,
 "name": "Word Counter \u2013 Selection & Page",
 "short_name": "Word Counter",
 "version": "1.0.0",
 "description": "Count words, characters and reading time of the selected text or the whole page.",
 "action": {
  "default_popup": "popup.html",
  "default_title": "Word Counter"
 },
 "permissions": [
  "activeTab",
  "scripting"
 ],
 "icons": {
  "16": "icon-16.png",
  "48": "icon-48.png",
  "128": "icon-128.png"
 }
}